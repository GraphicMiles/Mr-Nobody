<?xml version="1.0" encoding="utf-8"?>
<!-- No data is backed up or transferred off-device, ever. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
