<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ============ BROWSER CHROME ============ -->
    <LinearLayout
        android:id="@+id/browser_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Address / search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/addr_bar_bg"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/secure_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="@string/lock_secure" />

            <EditText
                android:id="@+id/address_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:hint="@string/addr_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/addr_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/text_dim"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Web content container (one GeckoView per tab is attached here) -->
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom toolbar: ←  +  □  ⋮ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:elevation="6dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text_dim"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_new_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/text_dim"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_tabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="□"
                android:textColor="@color/text_dim"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/text_dim"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ PRIVACY DASHBOARD (overlay) ============ -->
    <LinearLayout
        android:id="@+id/privacy_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/privacy_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text_dim"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_title"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView style="@style/SectionLabel" android:text="@string/privacy_this_page" />
                <TextView style="@style/DashRow" android:text="@string/privacy_score" />
                <TextView style="@style/DashRowValue" android:id="@+id/dash_score" />
                <TextView style="@style/DashRow" android:text="@string/privacy_ads_blocked" />
                <TextView style="@style/DashRowValue" android:id="@+id/dash_ads" />
                <TextView style="@style/DashRow" android:text="@string/privacy_trackers_blocked" />
                <TextView style="@style/DashRowValue" android:id="@+id/dash_trackers" />

                <TextView style="@style/SectionLabel" android:text="@string/privacy_today" />
                <TextView style="@style/DashRow" android:text="@string/privacy_ads_blocked" />
                <TextView style="@style/DashRowValue" android:id="@+id/dash_today_ads" />
                <TextView style="@style/DashRow" android:text="@string/privacy_trackers_blocked" />
                <TextView style="@style/DashRowValue" android:id="@+id/dash_today_trackers" />

                <TextView style="@style/SectionLabel" android:text="@string/privacy_history" />
                <TextView style="@style/DashRow" android:text="@string/privacy_history_saved" />
                <TextView style="@style/DashRowValue" android:id="@+id/dash_history" />

                <TextView style="@style/SectionLabel" android:text="@string/privacy_cookies" />
                <TextView style="@style/DashRow" android:text="@string/privacy_third_party" />
                <TextView style="@style/DashRowValue" android:text="@string/privacy_cookies_blocked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:fontFamily="monospace"
                    android:text="@string/privacy_stays_local"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ============ FIRST LAUNCH (overlay) ============ -->
    <LinearLayout
        android:id="@+id/first_launch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="@string/fl_title"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/fl_sub"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView style="@style/FirstLaunchCheck" android:text="@string/fl_ads" />
            <TextView style="@style/FirstLaunchCheck" android:text="@string/fl_trackers" />
            <TextView style="@style/FirstLaunchCheck" android:text="@string/fl_history" />
        </LinearLayout>

        <Button
            android:id="@+id/fl_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/accent"
            android:text="@string/fl_start"
            android:textColor="@color/accent_ink" />

        <TextView
            android:id="@+id/fl_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/fl_privacy_settings"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
