<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only ever used to tell you a task you started has finished. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Downloads are performed by this app, not handed to the system
         downloader, so they need a foreground service to survive the user
         switching away. The flip side is the one the user asked for: they stop
         when Mr Nobody is uninstalled. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Cleartext is an explicit non-feature: shared/bare HTTP inputs are
         upgraded before navigation, and credential-bearing endpoints require HTTPS. -->
    <application
        android:name=".MrNobodyApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="Mr Nobody"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Enumerate supported hosts; a scheme-only filter lets any
                     invented command reach the exported activity. Side-effecting
                     task links still require an in-app confirmation. -->
                <data android:scheme="mrnobody" android:host="open" />
                <data android:scheme="mrnobody" android:host="search" />
                <data android:scheme="mrnobody" android:host="task" />
                <data android:scheme="mrnobody" android:host="tabs" />
                <data android:scheme="mrnobody" android:host="tasks" />
                <data android:scheme="mrnobody" android:host="settings" />
                <data android:scheme="mrnobody" android:host="privacy" />
                <data android:scheme="mrnobody" android:host="downloads" />
                <data android:scheme="mrnobody" android:host="clear" />
            </intent-filter>
        </activity>

        <!-- WorkManager promotes active agent work to dataSync so searches and
             rendered reads continue when the activity is backgrounded. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Carries downloads while the user is elsewhere in the app or off
             it entirely. Not exported: nothing outside Mr Nobody may start a
             download. -->
        <service
            android:name="com.mrnobody.browser.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Built-in Tor (tor-android's service). Declared here explicitly —
             the AAR's own manifest entry carries no exported attribute — and
             never exported: only Mr Nobody may start or stop its Tor. It runs
             only when the user selects the Tor route and Orbot is absent;
             see browser/net/EmbeddedTor. -->
        <service
            android:name="org.torproject.jni.TorService"
            android:exported="false"
            tools:node="merge" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
